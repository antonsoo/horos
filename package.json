{
  "name": "@antonsoloviev/horos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build Aristotle's counterexamples and explore Sextus's disputed conditional through Greek, changing facts and explicit finite models.",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/horos.git"
  },
  "homepage": "https://antonsoo.github.io/horos/",
  "keywords": [
    "aristotle",
    "logic",
    "ancient-greek",
    "latin",
    "counterexamples",
    "education",
    "prior-analytics",
    "sextus-empiricus",
    "conditionals",
    "hellenistic-logic"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4370 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4369 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test:browser": "node scripts/browser.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:sources && npm run build",
    "test:readiness": "node scripts/readiness-audit.mjs",
    "test:conditionals": "node scripts/conditional-review.mjs",
    "test:portable": "node scripts/portable-review.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
